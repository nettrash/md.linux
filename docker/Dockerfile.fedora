# md for Linux — the Fedora image the .rpm is built in (scripts/package-rpm.sh, docs/packaging.md §12).
#
# Fedora 44, the oldest release that has every library md is built against (GTK 4.22, libadwaita
# 1.9, WebKitGTK 6.0 2.52); a package built here installs on 44 and later. The base image is pinned
# by digest; Fedora keeps no archive snapshots, so the packages are the archive's current ones.
FROM fedora:44@sha256:43b29f65a41eb9c35e1cd5323e3bdf3b655c2357a9f4f1ff2f9c2798e5045d80

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN dnf -y install --setopt=install_weak_deps=False \
      gcc pkgconf-pkg-config binutils findutils gzip \
      rust cargo \
      gtk4-devel libadwaita-devel webkitgtk6.0-devel \
      rpm-build rpmlint \
 && dnf clean all

ENV CARGO_HOME=/cargo \
    CARGO_TARGET_DIR=/target

RUN mkdir -p /cargo /target /src

WORKDIR /src
